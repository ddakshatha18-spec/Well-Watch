# Public values only. NEVER put a Bearer token, AWS key or secret in a VITE_ variable:
# everything prefixed VITE_ is bundled into the public JavaScript.
VITE_API_BASE_URL=https://e95a0mqwd6.execute-api.ap-south-1.amazonaws.com/Prod
# Optional: Amazon Location Service map (URL-restricted API key, safe for browsers when
# restricted to your Amplify domain). Leave empty to use the OpenStreetMap fallback.
VITE_LOCATION_API_KEY=
VITE_LOCATION_REGION=ap-south-1
